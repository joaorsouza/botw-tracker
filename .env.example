# ---------------------------------------------------------------------------
# Copie para .env.local (ignorado pelo git) e preencha.
# Os valores vêm do Neon Console → projeto botw-tracker.
#
# APENAS SERVIDOR — lido pelas Vercel Functions em api/.
# NUNCA prefixe nada aqui com VITE_: isso jogaria a senha do banco dentro do
# JavaScript que qualquer pessoa baixa no navegador.
# ---------------------------------------------------------------------------

# Connection string *pooled* (host com `-pooler`) da branch Neon do ambiente.
# Local e previews usam a branch `dev`; produção usa a branch `production`.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Auth Base URL do Neon Auth. Não é segredo, mas o servidor precisa da própria
# cópia: issuer e JWKS são derivados daqui, nunca de algo que venha na request.
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.sa-east-1.aws.neon.tech/neondb/auth
